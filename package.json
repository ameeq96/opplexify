{
  "name": "adon-dynamic-platform",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:api\" \"npm run start:web\"",
    "build": "npm run build -w @adon/shared && npm run build -w @adon/api && npm run build -w @adon/web",
    "qa:e2e": "playwright test",
    "qa:e2e:ui": "playwright test --ui",
    "qa:e2e:report": "playwright show-report",
    "start:api": "npm run dev -w @adon/api",
    "start:web": "npm run dev -w @adon/web",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts",
    "db:migrate": "prisma migrate dev --config apps/api/prisma.config.ts",
    "db:seed": "prisma db seed --config apps/api/prisma.config.ts",
    "db:studio": "prisma studio --config apps/api/prisma.config.ts",
    "hostinger:build:web": "npm run build -w @adon/shared && npm run build -w @adon/web",
    "hostinger:start:web": "npm run start -w @adon/web",
    "hostinger:build:api": "npm run db:generate && npm run build -w @adon/shared && npm run build -w @adon/api && npm run hostinger:verify:api-output",
    "hostinger:check:api": "node scripts/check-hostinger-api.cjs --production",
    "hostinger:verify:api-output": "node scripts/verify-api-output.cjs",
    "hostinger:start:api": "npm run hostinger:check:api && node main.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "concurrently": "^9.2.1",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13"
  }
}
