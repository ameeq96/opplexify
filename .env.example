# Hostinger production reference:
# Single Hostinger app:
# NODE_ENV=production
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=HOSTINGER_DATABASE_NAME
# DB_USERNAME=HOSTINGER_DATABASE_USER
# DB_PASSWORD=HOSTINGER_DATABASE_PASSWORD
# JWT_SECRET="use-at-least-32-random-characters"
# JWT_EXPIRES_IN="8h"
# TRUST_PROXY_HOPS=1
# ALLOWED_HOSTS=""
# WEB_ORIGIN="https://opplexify.com"
# ADMIN_EMAIL="admin@opplexify.com"
# ADMIN_PASSWORD="use-a-strong-temporary-admin-password"
# SAFEPAY_ENVIRONMENT="production"
# SAFEPAY_PUBLIC_KEY="your-live-public-key"
# SAFEPAY_SECRET_KEY="your-live-secret-key"
# SAFEPAY_WEBHOOK_SECRET="your-webhook-signing-secret"
# OPPLEX_CATALOG_URL="https://opplexiptv.com/integrations/opplexify/catalog"
# OPPLEX_HANDOFF_SECRET="same-strong-secret-configured-on-opplexiptv"
# NEXT_PUBLIC_SITE_URL="https://opplexify.com"
# Leave NEXT_PUBLIC_API_URL unset for same-domain API routes.
