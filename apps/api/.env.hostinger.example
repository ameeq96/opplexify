NODE_ENV=production
DB_CONNECTION=mysql
DB_HOST=HOSTINGER_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=HOSTINGER_DATABASE_NAME
DB_USERNAME=HOSTINGER_DATABASE_USER
DB_PASSWORD=HOSTINGER_DATABASE_PASSWORD
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=7d
WEB_ORIGIN=https://opplexify.com
ADMIN_EMAIL=admin@opplexify.com
ADMIN_PASSWORD=replace-with-a-strong-temporary-admin-password

# Optional. If set, DATABASE_URL overrides DB_* above.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
