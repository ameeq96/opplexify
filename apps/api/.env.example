# Option A: Laravel-style DB variables (recommended for Hostinger)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adon
DB_USERNAME=adon
DB_PASSWORD=adon

# Option B: Direct Prisma/MySQL URL. If set, this overrides DB_* above.
# DATABASE_URL="mysql://adon:adon@localhost:3306/adon?allowPublicKeyRetrieval=false"

JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="8h"
TRUST_PROXY_HOPS=0
ALLOWED_HOSTS=""
PORT=4000
WEB_ORIGIN="http://localhost:3000"
ADMIN_EMAIL="admin@opplexify.local"
ADMIN_PASSWORD="Admin123!"
SAFEPAY_ENVIRONMENT="sandbox"
SAFEPAY_SANDBOX_PUBLIC_KEY=""
SAFEPAY_SANDBOX_SECRET_KEY=""
SAFEPAY_PUBLIC_KEY=""
SAFEPAY_SECRET_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_INTENT="CYBERSOURCE"
OPPLEX_CATALOG_URL="https://opplexiptv.com/integrations/opplexify/catalog"
OPPLEX_HANDOFF_SECRET="replace-with-the-same-secret-used-by-opplexiptv"

# Hostinger production reference:
# NODE_ENV=production
# DB_CONNECTION=mysql
# DB_HOST=HOSTINGER_MYSQL_HOST
# DB_PORT=3306
# DB_DATABASE=HOSTINGER_DATABASE_NAME
# DB_USERNAME=HOSTINGER_DATABASE_USER
# DB_PASSWORD=HOSTINGER_DATABASE_PASSWORD
# JWT_SECRET="use-at-least-32-random-characters"
# JWT_EXPIRES_IN="8h"
# TRUST_PROXY_HOPS=1
# ALLOWED_HOSTS=""
# WEB_ORIGIN="https://opplexify.com"
# ADMIN_EMAIL="admin@opplexify.com"
# ADMIN_PASSWORD="use-a-strong-temporary-admin-password"
# SAFEPAY_ENVIRONMENT="production"
# SAFEPAY_PUBLIC_KEY="your-live-public-key"
# SAFEPAY_SECRET_KEY="your-live-secret-key"
# SAFEPAY_WEBHOOK_SECRET="your-webhook-signing-secret"
# OPPLEX_CATALOG_URL="https://opplexiptv.com/integrations/opplexify/catalog"
# OPPLEX_HANDOFF_SECRET="same-strong-secret-configured-on-opplexiptv"
