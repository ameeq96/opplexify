# Option A: Laravel-style DB variables (recommended for Hostinger)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adon
DB_USERNAME=adon
DB_PASSWORD=adon

# Option B: Direct Prisma/MySQL URL. If set, this overrides DB_* above.
# DATABASE_URL="mysql://adon:adon@localhost:3306/adon?allowPublicKeyRetrieval=true"

JWT_SECRET="change-this-super-secret"
JWT_EXPIRES_IN="7d"
PORT=4000
WEB_ORIGIN="http://localhost:3000"
ADMIN_EMAIL="admin@opplexify.local"
ADMIN_PASSWORD="Admin123!"

# Hostinger production reference:
# NODE_ENV=production
# DB_CONNECTION=mysql
# DB_HOST=HOSTINGER_MYSQL_HOST
# DB_PORT=3306
# DB_DATABASE=HOSTINGER_DATABASE_NAME
# DB_USERNAME=HOSTINGER_DATABASE_USER
# DB_PASSWORD=HOSTINGER_DATABASE_PASSWORD
# JWT_SECRET="use-a-strong-production-secret"
# JWT_EXPIRES_IN="7d"
# WEB_ORIGIN="https://opplexify.com"
# ADMIN_EMAIL="admin@opplexify.com"
# ADMIN_PASSWORD="use-a-strong-temporary-admin-password"
